{
  "name": "git-ui-booster",
  "version": "1.0.0",
  "description": "Boost your Git workflow. Works with GitHub and GitHub Enterprise!",
  "main": "index.js",
  "scripts": {
    "watch": "webpack --config webpack/webpack.dev.js --watch",
    "prebuild": "npm run clean",
    "build": "webpack --config webpack/webpack.prod.js",
    "build:pack": "webpack --config webpack/webpack.prod.js && zip -r dist.zip ./dist",
    "clean": "rimraf dist",
    "test": "npx jest",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watch",
    "coverage:open": "open coverage/index.html",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "release": "npm run build && zip -r dist.zip dist && VERSION=$(jq -er .version public/manifest.json) && git tag v$VERSION"
  },
  "lint-staged": {
    "*": "prettier --write",
    "*.{js,ts,tsx,d.ts}": [
      "eslint --fix --no-warn-ignored --max-warnings=0"
    ]
  },
  "license": "ISC",
  "maintainers": [
    {
      "name": "Hans Krebs",
      "githubUsername": "HansKre",
      "url": "https://github.com/HansKre"
    },
    {
      "name": "Lucas Calefi Giglio",
      "githubUsername": "lukegskw",
      "url": "https://github.com/lukegskw"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HansKre/git-ui-booster"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.1",
    "@primer/octicons-react": "^19.12.0",
    "@primer/react": "^36.27.0",
    "axios": "^1.7.9",
    "formik": "^2.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.11",
    "ts-type-safe": "^1.4.0",
    "yup": "^1.4.0"
  },
  "overrides": {
    "js-yaml": "^4.1.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.3",
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/axios": "^0.9.36",
    "@types/chrome": "^0.0.269",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.0.29",
    "@types/react-dom": "^18.0.11",
    "@types/styled-components": "^5.1.34",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-hooks-addons": "^0.4.1",
    "glob": "^11.0.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.0",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.4",
    "typescript-eslint": "^8.16.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.0"
  }
}
