{
  "manifest_version": 3,

  "name": "Git UI Booster",
  "description": "Boost your Git workflow. Works with GitHub and GitHub Enterprise!",
  "version": "1.8",

  "action": {
    "default_icon": "icon16.png",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["js/vendor.js", "js/content_pr_page.js"]
    },
    {
      "matches": ["https://*/*"],
      "js": ["js/vendor.js", "js/content_prs_page.js"]
    },
    {
      "matches": ["https://*/*"],
      "js": ["js/vendor.js", "js/content_compare_page.js"]
    }
  ],

  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "background": {
    "service_worker": "js/background.js"
  }
}
